{https://github.com/LeafyShadow696/ProTebe/pull/1/conflict?name=vercel.json&base_oid=d6cd322df96ea1e6f979d122a32df3522cbd234b&head_oid=e8b8e1db182be9da7b1f4a78f38bf557edb09e84
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR_BACKEND_URL/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=self, microphone=()"
        }
      ]
    }
  ]
}
